{
  "name": "open-herbology",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:user-data": "node --experimental-strip-types --test scripts/test-user-data.mjs",
    "test:formula-analysis": "node --experimental-strip-types --test scripts/test-formula-analysis.mjs",
    "extract:apk-data": "python scripts/extract_apk_data.py",
    "i18n:progress": "node scripts/i18n_progress.mjs",
    "cap:sync": "next build && cap sync android",
    "cap:assets": "capacitor-assets generate --android",
    "apk:debug": "powershell -ExecutionPolicy Bypass -File tools/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "lucide-react": "^0.469.0",
    "next": "15.5.24",
    "pinyin-pro": "^3.28.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
